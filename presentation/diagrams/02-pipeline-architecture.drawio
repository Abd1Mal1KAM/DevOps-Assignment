    <mxCell id="title" value="CI/CD Pipeline: GitHub Actions (deploy.yml)" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="180" y="10" width="480" height="30" as="geometry" />
    </mxCell>

