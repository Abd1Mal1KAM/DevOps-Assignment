      <mxGeometry x="340" y="60" width="160" height="50" as="geometry" />
    </mxCell>

    <!-- Phase 1 label -->
    <mxCell id="phase1" value="Phase 1 — Security scanning jobs (run in parallel)" style="text;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="60" y="130" width="720" height="20" as="geometry" />
    </mxCell>

    <!-- Job 1: CodeQL -->
    <mxCell id="codeql" value="sast-codeql&#10;(CodeQL scans app code)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="60" y="170" width="170" height="60" as="geometry" />
    </mxCell>

    <!-- Job 2: Gitleaks -->
    <mxCell id="gitleaks" value="secrets-scan&#10;(Gitleaks scans repo history)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="250" y="170" width="170" height="60" as="geometry" />
    </mxCell>

    <!-- Job 3: Checkov -->
    <mxCell id="checkov" value="security-iac&#10;(Checkov scans Terraform)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="440" y="170" width="170" height="60" as="geometry" />
    </mxCell>

    <!-- Job 4: ansible-lint -->
    <mxCell id="ansiblelint" value="security-ansible&#10;(ansible-lint scans playbook)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="630" y="170" width="170" height="60" as="geometry" />
    </mxCell>

    <!-- Gate -->
    <mxCell id="gate" value="needs: [all 4 jobs above]&#10;All must pass to proceed" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="345" y="280" width="170" height="80" as="geometry" />
    </mxCell>

    <!-- Phase 2 label -->
    <mxCell id="phase2" value="Phase 2 — Deploy job (only runs if all scans pass)" style="text;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="60" y="400" width="720" height="20" as="geometry" />
    </mxCell>

    <!-- Deploy steps -->
