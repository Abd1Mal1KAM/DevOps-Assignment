    </mxCell>

    <mxCell id="tfapply" value="Terraform apply&#10;(creates SG + EC2 instance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="240" y="440" width="180" height="50" as="geometry" />
